NODE_ENV=production
PORT=8080

# Core
MONGO_URI=

# Auth
JWT_SECRET=
GOOGLE_CLIENT_ID=
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
ADMIN_JWT_SECRET=

# Mailgun SMTP
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_NAME=Hoko

# Admin login
ADMIN_USER=
ADMIN_PASS=

# CORS / Client
CLIENT_URL=https://www.hokoapp.in

# SMS
FAST2SMS_API_KEY=
FAST2SMS_OTP_ROUTE=dlt
# For FAST2SMS_OTP_ROUTE=dlt
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_MESSAGE_ID=
# For FAST2SMS_OTP_ROUTE=dlt_manual
FAST2SMS_DLT_ENTITY_ID=
FAST2SMS_DLT_TEMPLATE_ID=
# FAST2SMS_DLT_BULK_TEMPLATE_ID is also accepted as a backward-compatible alias.
# For Android/browser auto-fill, include the domain + OTP in the approved SMS template.
# Example: "Your Hoko OTP is {{OTP}}.\n@hokoapp.in #{{OTP}}"
FAST2SMS_DLT_MESSAGE_TEXT={{OTP}} is your verification code.

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hokoapp.in

# Firebase native Android push
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or point to a JSON service account file:
# FIREBASE_SERVICE_ACCOUNT_PATH=server/firebase-service-account.json

# AI content
GEMINI_API_KEY=
GEMINI_CONTENT_MODEL=gemini-2.5-flash
GEMINI_CAMPAIGN_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
AI_CONTENT_GENERATE_IMAGES=true
AI_CONTENT_CAMPAIGN_GENERATE_IMAGES=false

# Buffer publishing
BUFFER_API_KEY=
BUFFER_DEFAULT_CHANNEL_ID=
BUFFER_ORGANIZATION_ID=
