VITE_API_URL=http://localhost:8080/api

# Core
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=hoko-db

GOOGLE_CLIENT_ID=your-google-client-ids (comma-separated)

CLIENT_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

DEV_OTP_BYPASS=false
DEV_AUTH_BYPASS=false
DEV_DROP_MOBILE_INDEX=false

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your-smtp-user@domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=postmaster@domain.com
SMTP_ENVELOPE_FROM=postmaster@domain.com
APP_NAME=Hoko

# Auth
JWT_SECRET=generate-a-256-bit-random-string
OTP_SECRET=generate-another-random-string
ADMIN_JWT_SECRET=generate-admin-secret-key

# Admin login
ADMIN_USER=your-admin-username
ADMIN_PASS=your-admin-password

# OTP rules
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# SMS
FAST2SMS_API_KEY=your-fast2sms-api-key

# Mobile notification
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@domain.com

# WhatsApp (Gupshup)
WHATSAPP_PROVIDER=gupshup
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_ID=your-gupshup-app-id
GUPSHUP_APP_NAME=your-app-name
GUPSHUP_SOURCE=919876543210
GUPSHUP_SEND_URL=https://api.gupshup.io/wa/api/v1/msg
GUPSHUP_TEMPLATE_SEND_URL=https://api.gupshup.io/wa/api/v1/template/msg