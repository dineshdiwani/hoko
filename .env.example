VITE_API_URL=http://localhost:8080/api

# Core
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=hoko-db

GOOGLE_CLIENT_ID=your-google-client-ids (comma-separated)

CLIENT_URL=https://your-domain.com
CORS_ORIGIN=https://your-domain.com

DEV_OTP_BYPASS=false
DEV_AUTH_BYPASS=false
DEV_DROP_MOBILE_INDEX=false

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your-smtp-user@domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=postmaster@domain.com
SMTP_ENVELOPE_FROM=postmaster@domain.com
APP_NAME=Hoko

# Auth
JWT_SECRET=generate-a-256-bit-random-string-use-node_crypto
OTP_SECRET=generate-another-random-string
ADMIN_JWT_SECRET=generate-admin-secret-key

# Admin login
ADMIN_USER=your-admin-username
ADMIN_PASS=your-admin-password

# OTP rules
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# SMS
FAST2SMS_API_KEY=your-fast2sms-api-key
FAST2SMS_SENDER_ID=HOKOPM

# Approved DLT template for login OTPs.
# Example rendered message:
# Your Hoko OTP is 123456.
# @hokoapp.in #123456
FAST2SMS_DLT_MESSAGE_ID=

# Approved DLT template for automated event SMS.
# Example rendered message:
# Hoko alert: Requirement is live. Sellers will compete to offer you the best price.
# Open here: https://hokoapp.in/seller/deeplink/REQ12345
# Template form:
# Hoko alert: {#var#}. {#var#}. Open here: {#var#}
FAST2SMS_DLT_EVENT_MESSAGE_ID=

# Mobile notification
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@domain.com

# Deep link verification
ANDROID_PACKAGE_NAME=com.hoko.app
ANDROID_SHA256_CERT_FINGERPRINTS=
APPLE_APP_ID_PREFIX=
APPLE_BUNDLE_ID=com.hoko.app
APPLE_ASSOCIATED_PATHS=/seller/*,/buyer/*,/post-requirement,/buyer/requirement/*

# WhatsApp (Gupshup)
WHATSAPP_DISABLED=false
WHATSAPP_CHATBOT_ENABLED=true
WHATSAPP_PROVIDER=gupshup
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_ID=your-gupshup-app-id
GUPSHUP_APP_NAME=your-app-name
GUPSHUP_SOURCE=919876543210
GUPSHUP_SEND_URL=https://api.gupshup.io/wa/api/v1/msg
GUPSHUP_TEMPLATE_SEND_URL=https://api.gupshup.io/wa/api/v1/template/msg

# Error Tracking (Sentry)
SENTRY_DSN=your-sentry-dsn-from-sentry.io
VITE_SENTRY_DSN=your-sentry-dsn-from-sentry.io

# AI content
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CONTENT_MODEL=gemini-2.5-flash
GEMINI_CAMPAIGN_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
AI_CONTENT_GENERATE_IMAGES=true
AI_CONTENT_CAMPAIGN_GENERATE_IMAGES=false

# Buffer publishing
BUFFER_API_KEY=your-buffer-api-key
BUFFER_DEFAULT_CHANNEL_ID=
BUFFER_ORGANIZATION_ID=
